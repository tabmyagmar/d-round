{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "LOG_LEVEL",
    "API_PORT",
    "API_URL",
    "WEB_ORIGIN",
    "BETTER_AUTH_SECRET",
    "COOKIE_DOMAIN",
    "DATABASE_URL",
    "REDIS_URL",
    "MAIL_SMTP_URL",
    "MAIL_FROM"
  ],
  "globalPassThroughEnv": [
    "DOCKER_HOST",
    "DOCKER_CONFIG",
    "DOCKER_CERT_PATH",
    "DOCKER_TLS_VERIFY",
    "TESTCONTAINERS_*",
    "HOME",
    "TMPDIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "^db:generate"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "@repo/database#build": {
      "dependsOn": ["db:generate"]
    },
    "@repo/database#lint": {
      "dependsOn": ["db:generate"]
    },
    "@repo/database#typecheck": {
      "dependsOn": ["db:generate"]
    },
    "@repo/database#test": {
      "dependsOn": ["db:generate"]
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$", "!.turbo/**"]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    }
  }
}
