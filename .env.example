# Copy to `.env` (git-ignored). Every app loads this root file via dotenv, and Prisma
# reads it from prisma.config.ts. Never commit real secrets.

# --- Docker services (docker-compose.yml) -------------------------------------------
# Host ports deliberately avoid the defaults (5432/6379) so this stack can run next to
# another local Postgres/Redis. Keep DATABASE_URL / REDIS_URL below in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow
POSTGRES_PORT=5433
REDIS_PORT=6380
PGADMIN_PORT=5050
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
# Apple Silicon (optional, native instead of Rosetta): see docker-compose.yml
# POSTGRES_IMAGE=imresamu/postgis:18-3.6
# POSTGRES_PLATFORM=linux/arm64

# --- Shared ------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/workflow?schema=public
REDIS_URL=redis://localhost:6380

# --- apps/api ----------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# openssl rand -base64 32 — rotating it signs everyone out
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# COOKIE_DOMAIN=example.com   # production: parent domain shared by web + api

# --- apps/worker (mail) — Mailpit UI http://localhost:8025 -----------------------------
# The display name before the address is the brand used in email subjects and bodies.
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM="{{MAIL_FROM}}"

# --- apps/web (Next.js reads NEXT_PUBLIC_* at build time) ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
