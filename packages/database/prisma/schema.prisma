// Prisma 7: the datasource URL lives in prisma.config.ts, the client is generated into
// src/generated (git-ignored) and uses the pg driver adapter (see src/client.ts).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Conventions: PascalCase models mapped to snake_case tables and columns,
/// UUID v7 primary keys (time-ordered, index friendly), explicit created_at.

/// Used by the health endpoint and integration tests to prove migrations ran.
model HealthCheck {
  id        String   @id @default(uuid(7)) @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

// ---------------------------------------------------------------------------------------
// Better Auth core schema (user, session, account, verification) + admin plugin fields.
// Generated with `npx auth generate` from packages/auth/auth-cli.config.ts and merged by
// hand: snake_case mapping, UUID v7 ids (Better Auth runs with generateId: false), d-round
// fields (employeeCode, department, deletedAt). Field names must stay as Better Auth expects.
// See docs/adr/0002-auth.md.
// ---------------------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  /// admin plugin: admin | hr_manager | dept_head | member (allowed set: @repo/validation roleSchema)
  role       String?   @default("member")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  /// d-round
  employeeCode String?   @unique @map("employee_code")
  department   String?
  /// Soft delete (deactivate). Deactivated users cannot sign in; rows are never deleted.
  deletedAt    DateTime? @map("deleted_at")

  sessions Session[]
  accounts Account[]

  @@index([department])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// admin plugin
  impersonatedBy String? @map("impersonated_by")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------------------
// Outbox: the durable record of every email. The queue is only a trigger; this row is the
// truth (PENDING → SENT | FAILED). See docs/adr/0004-outbox.md and .claude/rules/queue.md.
// ---------------------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

model OutboxEmail {
  id        String       @id @default(uuid(7)) @db.Uuid
  to        String
  template  String
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  sentAt    DateTime?    @map("sent_at")
  lastError String?      @map("last_error")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_emails")
}
