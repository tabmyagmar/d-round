// A CSV import (docs/adr/0013-csv-import.md). The row is the truth, the queue only a trigger:
// UPLOADED → CHECKING → CHECKED → CONFIRMED → IMPORTING → IMPORTED, or FAILED (a system failure).

/// What the file adds or updates (the legacy EnumCsvUploadType). An UPDATE row finds its target by
/// the number column: 社員番号, スタッフ番号, クライアント番号, クライアント番号 + 就業先番号.
enum CsvImportType {
  USER_CREATE
  USER_UPDATE
  STAFF_CREATE
  STAFF_UPDATE
  CLIENT_CREATE
  CLIENT_UPDATE
  BRANCH_CREATE
  BRANCH_UPDATE

  @@map("csv_import_type")
}

/// UPLOADED: waiting for the check job. CHECKING: the worker reads the file. CHECKED: rows and their
/// errors stored, waiting for the user. CONFIRMED: rows chosen, waiting for the import job.
/// IMPORTING: rows being written one by one. IMPORTED: done (some rows may have failed). FAILED: a
/// system failure stopped the check or the import (`last_error`).
enum CsvImportStatus {
  UPLOADED
  CHECKING
  CHECKED
  CONFIRMED
  IMPORTING
  IMPORTED
  FAILED

  @@map("csv_import_status")
}

model CsvImport {
  id             String          @id @default(uuid(7)) @db.Uuid
  type           CsvImportType
  status         CsvImportStatus @default(UPLOADED)
  /// The picked file's name (sanitised); the file itself is the CSV_IMPORT attachment.
  fileName       String          @map("file_name") @db.VarChar(255)
  /// Who uploaded it: the import runs with this user's grants, and only they see it (legacy rule).
  createdById    String          @map("created_by_id") @db.Uuid
  /// Data rows in the file, rows without check errors, rows the user confirmed.
  totalCount     Int             @default(0) @map("total_count")
  validCount     Int             @default(0) @map("valid_count")
  selectedCount  Int             @default(0) @map("selected_count")
  /// Confirmed rows written so far (progress), and how many of them succeeded or failed.
  processedCount Int             @default(0) @map("processed_count")
  importedCount  Int             @default(0) @map("imported_count")
  failedCount    Int             @default(0) @map("failed_count")
  /// A finding about the whole file (a missing column, too many rows): nothing can be imported.
  fileError      String?         @map("file_error")
  /// Why the import is FAILED.
  lastError      String?         @map("last_error")
  checkedAt      DateTime?       @map("checked_at")
  confirmedAt    DateTime?       @map("confirmed_at")
  importedAt     DateTime?       @map("imported_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  /// Bumped by every transition and every imported row: the sweeper's heartbeat.
  updatedAt      DateTime        @updatedAt @map("updated_at")

  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rows        CsvImportRow[]
  attachments Attachment[]

  @@index([createdById, type, createdAt])
  @@index([status, updatedAt])
  @@map("csv_imports")
}
