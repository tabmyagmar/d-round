// Role catalog (reference data). The four rows are inserted by the migration that added the
// foreign key `users.role → roles.key` (so a migrations-only database can insert users) and kept
// in sync by prisma/seed/roles.seed.ts. `key` is lower-case because it is what Better Auth stores
// in `users.role`; grants reference the natural key `key` too. A role cannot be deleted while a
// user holds it (Restrict). See docs/adr/0005-legacy-reference-data.md.

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  nameJp    String   @map("name_jp")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}
