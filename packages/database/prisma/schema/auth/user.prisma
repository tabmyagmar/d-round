// Better Auth core model + admin plugin fields + app fields. Generated with
// `npx auth generate` (packages/auth/auth-cli.config.ts) and merged by hand: snake_case mapping,
// UUID v7 ids (Better Auth runs with generateId: false), the relation `roleRef` over `role`.
// Field names must stay as Better Auth expects. See docs/adr/0002-auth.md.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// admin plugin: super_admin | admin | manager | staff (allowed set: @repo/validation roleSchema).
  /// References the role catalog (access/role.prisma): the database refuses any other value.
  role       String    @default("staff")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  /// Soft delete (deactivate). Deactivated users cannot sign in; rows are never deleted.
  deletedAt DateTime? @map("deleted_at")

  roleRef     Role             @relation(fields: [role], references: [key], onDelete: Restrict)
  sessions    Session[]
  accounts    Account[]
  permissions UserPermission[]

  @@index([role])
  @@map("users")
}
