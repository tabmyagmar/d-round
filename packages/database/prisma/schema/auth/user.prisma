// Better Auth core model + admin plugin fields + app fields. Generated with
// `npx auth generate` (packages/auth/auth-cli.config.ts) and merged by hand: snake_case mapping,
// UUID v7 ids (Better Auth runs with generateId: false), the relation `roleRef` over `role`.
// Field names must stay as Better Auth expects. See docs/adr/0002-auth.md.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// admin plugin: super_admin | admin | manager | am (allowed set: @repo/validation roleSchema).
  /// References the role catalog (access/role.prisma): the database refuses any other value.
  role       String    @default("am")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  /// Soft delete (deactivate). Deactivated users cannot sign in; rows are never deleted.
  deletedAt DateTime? @map("deleted_at")

  /// 姓 / 名 and their full-width katakana readings (セイ / メイ); `name` is "姓 名", written by the
  /// user service. Nullable until every user has them (ADR 0002, 2026-10-07).
  lastName      String? @map("last_name")
  firstName     String? @map("first_name")
  lastNameKana  String? @map("last_name_kana")
  firstNameKana String? @map("first_name_kana")

  roleRef          Role              @relation(fields: [role], references: [key], onDelete: Restrict)
  /// HR fields of a 担当者 (ADR 0007); none until the user is invited or edited with them.
  profile          UserProfile?
  sessions         Session[]
  accounts         Account[]
  permissions      UserPermission[]
  commentTemplates CommentTemplate[]
  /// スタッフ this user is or was 担当者 of (ADR 0008).
  staffCharges     StaffCharger[]
  /// クライアント this user is 担当者 of (ADR 0011).
  clientCharges    ClientCharger[]

  @@index([role])
  @@map("users")
}
