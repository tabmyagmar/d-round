{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npx prisma:*)",
      "Bash(npx shadcn:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(yarn prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  }
}
